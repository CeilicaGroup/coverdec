// Schema CoverDec MVP
// Person, ProcessDefinition, ElementType, Holiday son globales.
// Planning y PlanningPolicy son por nave. El resto es global.

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  // Host Debian + imagen node:alpine en Docker (dev y prod)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  JEFE_PRODUCCION
  OPERARIO
}

enum RiskLevel {
  OK
  ATENCION
  RIESGO
}

enum PlanningStatus {
  DRAFT
  PUBLISHED
}

enum TimeEntrySource {
  TIMER
  MANUAL
}

enum AttendanceSource {
  BUTTON
  MANUAL
  ADMIN_EDIT
}

enum NotificationType {
  PLAN_PUBLISHED_LOW_OCCUPATION
  PLAN_PUBLISHED_PROJECTS_OVER_DEADLINE
  TASK_HOURS_EXCEEDED
  TASK_TIME_DEVIATION_FROM_CATALOG
  PROJECT_SLIPPING
  ASSIGNED_TASKS_NOT_LOGGED
  ATTENDANCE_OUTSIDE_WORK_WINDOW
  ATTENDANCE_OPEN_TOO_LONG
  ATTENDANCE_INCOMPLETE_DAY
  ATTENDANCE_MISSING_WORKDAY
  DELIVERY_FAILED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum FactoryStatus {
  DOSSIER
  PRODUCCION
  CONTROL_CALIDAD
  EMBALAJE
  ENVIADO
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum ProjectPlanningPreset {
  A_TIEMPO
  EQUILIBRADO
  MIN_COSTE
}

enum ProjectKind {
  PRODUCCION
  PROTOTIPO
  PRESUPUESTO
  STOCK
  IMPREVISTAS
}

enum LampElementStockStatus {
  IN_PRODUCTION
  AVAILABLE
  ASSIGNED
}

enum WorkOrderStatus {
  OPEN
  CLOSED
}

enum TaskSystemKind {
  TRANSPORT
  AD_HOC
}

// ---------- Naves (talleres físicos, global) ----------

model Nave {
  id       String  @id @default(cuid())
  codigo   String  @unique
  nombre   String
  isActive Boolean @default(true)

  tasks               Task[]
  elementTypeDefaults ElementType[] @relation("ElementTypeDefaultNave")
  typologyDefaults    ElementTypologyNave[] @relation("TypologyDefaultNave")
  elementTypeProcesses ElementTypeProcess[] @relation("ElementTypeProcessNave")
  transportTasksFrom   Task[]                @relation("TransportFromNave")
  transportTasksTo     Task[]                @relation("TransportToNave")
  activeUsers         User[]          @relation("ActiveNave")
  personNaves         PersonNave[]
  plannings           Planning[]      @relation("NavePlannings")
  planningPolicy      PlanningPolicy? @relation("NavePolicy")
  notifications       Notification[]
}

/// Pesos multi-objetivo del motor CP-SAT (1:1 con nave).
model PlanningPolicy {
  id           String   @id @default(cuid())
  naveId       String   @unique
  wLate        Float    @default(1)
  wUnscheduled Float    @default(1)
  wLoadBalance Float    @default(1)
  wMove        Float    @default(1)
  wLaborCost   Float    @default(1)
  wPriority    Float    @default(0)
  deadlineCurveExponent Float @default(2)
  overduePenaltyMultiplier Float @default(2.5)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  nave Nave @relation("NavePolicy", fields: [naveId], references: [id], onDelete: Cascade)
}

// ---------- Auth (better-auth schema) ----------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(OPERARIO)
  banned        Boolean  @default(false)
  banReason     String?
  banExpires    DateTime?
  personId      String?  @unique
  activeNaveId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  person      Person?     @relation(fields: [personId], references: [id])
  timeEntries TimeEntry[]
  activeNave  Nave?       @relation("ActiveNave", fields: [activeNaveId], references: [id])
  notifications          Notification[]
  notificationSubscriptions NotificationSubscription[]
  notificationDeliveries NotificationDelivery[]
  notificationStates     NotificationState[]
  pushSubscriptions      PushSubscription[]
  responsibleProjects    Project[] @relation("ProjectResponsible")
  attendanceSessions     AttendanceSession[]
  tasksCreated           Task[]    @relation("TaskCreatedBy")
}

model Session {
  id               String   @id
  expiresAt        DateTime
  token            String   @unique
  ipAddress        String?
  userAgent        String?
  impersonatedBy   String?
  userId           String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------- Equipo productivo (global) ----------

model Person {
  id                 String   @id @default(cuid())
  alias              String?
  iniciales          String   @unique
  color              String
  hourlyRate         Decimal  @default(14.75) @db.Decimal(10, 2)
  overtimeHourlyRate Decimal  @default(22.13) @db.Decimal(10, 2)
  isActive           Boolean  @default(true)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user              User?
  personNaves       PersonNave[]
  specialties       PersonSpecialty[]
  absences          Absence[]
  assignments       PlanningAssignment[]
  workWindows       PersonWorkWindow[]
  scheduleOverrides PersonScheduleOverride[]
  attendanceSessions AttendanceSession[]
}

model PersonNave {
  personId String
  naveId   String

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  nave   Nave   @relation(fields: [naveId], references: [id], onDelete: Cascade)

  @@id([personId, naveId])
  @@index([naveId])
}

/// Plantilla semanal (Lun–Vie). Minutos desde medianoche UTC; endMinutes exclusivo.
model PersonWorkWindow {
  id           String @id @default(cuid())
  personId     String
  dayOfWeek    Int
  startMinutes Int
  endMinutes   Int

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, dayOfWeek])
}

model PersonScheduleOverride {
  id       String   @id @default(cuid())
  personId String
  date     DateTime @db.Date

  person  Person                 @relation(fields: [personId], references: [id], onDelete: Cascade)
  windows PersonOverrideWindow[]

  @@unique([personId, date])
}

model PersonOverrideWindow {
  id           String @id @default(cuid())
  overrideId   String
  startMinutes Int
  endMinutes   Int

  override PersonScheduleOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)
}

model PersonSpecialty {
  id         String            @id @default(cuid())
  personId   String
  process    String
  isPrimary  Boolean           @default(false)
  isFallback Boolean           @default(false)
  person     Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  definition ProcessDefinition @relation(fields: [process], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@unique([personId, process])
}

model ProcessDefinition {
  id          String  @id @default(cuid())
  code        String  @unique
  label       String
  factor      Float   @default(1)
  setupHours  Float   @default(0)
  waitHours   Float   @default(0)
  bgColor     String
  fgColor     String
  borderColor String
  canFragment Boolean @default(true)

  elementTypeProcesses ElementTypeProcess[]
  tasks                Task[]
  personSpecialties   PersonSpecialty[]
  planningAssignments PlanningAssignment[]
  timeEntries         TimeEntry[]
  productionOrders    ProductionOrder[]
}

// ---------- Catálogo de elementos ----------

enum ElementTypology {
  TELA
  BASTIDOR
  ILUMINACION
}

model ElementTypologyNave {
  typology      ElementTypology @id
  defaultNaveId String?
  defaultNave   Nave?           @relation("TypologyDefaultNave", fields: [defaultNaveId], references: [id], onDelete: SetNull)
}

model ElementType {
  id            String          @id @default(cuid())
  code          String          @unique
  name          String
  description   String?
  typology      ElementTypology @default(BASTIDOR)
  baseUnit      String          @default("m2")
  isActive      Boolean         @default(true)
  defaultNaveId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  defaultNave  Nave?              @relation("ElementTypeDefaultNave", fields: [defaultNaveId], references: [id], onDelete: SetNull)
  processes    ElementTypeProcess[]
  lamps        Lamp[]
  lampElements LampElement[]

  @@index([typology, isActive])
}

model ElementTypeProcess {
  id            String  @id @default(cuid())
  elementTypeId String
  process       String
  sequence      Int     @default(0)
  hoursPerUnit  Float
  fixedHours    Float   @default(0)
  notes         String?
  naveId        String?

  elementType ElementType       @relation(fields: [elementTypeId], references: [id], onDelete: Cascade)
  definition  ProcessDefinition @relation(fields: [process], references: [code], onDelete: Restrict, onUpdate: Cascade)
  nave        Nave?             @relation("ElementTypeProcessNave", fields: [naveId], references: [id], onDelete: SetNull)

  @@unique([elementTypeId, process])
  @@index([elementTypeId, sequence])
}

// ---------- Proyectos y producción ----------

model Project {
  id           String    @id @default(cuid())
  code         String    @unique
  name         String
  client       String?
  obra         String?
  deliveryDate DateTime?
  isBillable   Boolean   @default(true)
  isActive     Boolean   @default(true)
  kind         ProjectKind @default(PRODUCCION)
  planningPreset ProjectPlanningPreset @default(EQUILIBRADO)
  planningCostPriority Int @default(50)
  planningStability Int @default(50)
  planningDeadlineBoost Int @default(50)
  responsibleUserId String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lamps            Lamp[]
  tasks            Task[]
  timeEntries      TimeEntry[]
  productionOrders ProductionOrder[]
  responsibleUser  User? @relation("ProjectResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  notifications    Notification[]
  previousProjectLamps Lamp[] @relation("LampPreviousProject")
}

model Lamp {
  id            String   @id @default(cuid())
  projectId     String
  elementTypeId String?
  code          String?
  name          String
  nameKey       String
  width         Float?
  height        Float?
  depth         Float?
  units         Int      @default(1)
  surfaceM2     Float?
  notes                 String?
  returnedToStockAt     DateTime?
  returnedToStockReason String?
  previousProjectId     String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  previousProject Project? @relation("LampPreviousProject", fields: [previousProjectId], references: [id], onDelete: SetNull)
  elementType  ElementType?  @relation(fields: [elementTypeId], references: [id])
  elements     LampElement[]
  tasks        Task[]
  timeEntries  TimeEntry[]

  @@unique([projectId, nameKey])
}

model LampElement {
  id            String   @id @default(cuid())
  lampId        String
  elementTypeId String
  label         String?
  surfaceM2     Float?
  units          Int      @default(1)
  stockStatus    LampElementStockStatus?
  stockBatchCode String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lamp        Lamp        @relation(fields: [lampId], references: [id], onDelete: Cascade)
  elementType ElementType @relation(fields: [elementTypeId], references: [id])
  tasks       Task[]

  @@unique([lampId, elementTypeId, label])
  @@index([lampId])
  @@index([elementTypeId])
}

model WorkOrder {
  id        String          @id @default(cuid())
  number    String          @unique
  year      Int
  serial    Int
  status    WorkOrderStatus @default(OPEN)
  notes     String?
  closedAt  DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tasks Task[]

  @@unique([year, serial])
}

model Task {
  id             String   @id @default(cuid())
  projectId      String
  lampId         String
  lampElementId  String?
  process        String
  estimatedHours Float
  isCompleted    Boolean  @default(false)
  order          Int      @default(0)
  naveId         String
  notes          String?
  workOrderId       String?
  workOrderSequence Int?
  systemKind        TaskSystemKind?
  transportFromNaveId String?
  transportToNaveId   String?
  transportAfterTaskId String?
  createdByUserId      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUser     User?                @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lamp              Lamp                 @relation(fields: [lampId], references: [id], onDelete: Cascade)
  lampElement       LampElement?         @relation(fields: [lampElementId], references: [id], onDelete: SetNull)
  processDefinition ProcessDefinition    @relation(fields: [process], references: [code], onDelete: Restrict, onUpdate: Cascade)
  nave              Nave                 @relation(fields: [naveId], references: [id])
  transportFromNave Nave?                @relation("TransportFromNave", fields: [transportFromNaveId], references: [id], onDelete: SetNull)
  transportToNave   Nave?                @relation("TransportToNave", fields: [transportToNaveId], references: [id], onDelete: SetNull)
  workOrder         WorkOrder?           @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  assignments       PlanningAssignment[]
  timeEntries       TimeEntry[]

  @@index([lampElementId])
  @@index([workOrderId, workOrderSequence])
}

// ---------- Planning ----------

model Planning {
  id          String         @id @default(cuid())
  naveId      String
  year        Int
  week        Int
  weekStart   DateTime
  weekEnd     DateTime
  status      PlanningStatus @default(DRAFT)
  publishedAt DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  nave        Nave                 @relation("NavePlannings", fields: [naveId], references: [id], onDelete: Cascade)
  assignments PlanningAssignment[]
  notifications Notification[]

  @@unique([naveId, year, week])
}

model PlanningAssignment {
  id          String   @id @default(cuid())
  planningId  String
  taskId      String
  personId    String
  date        DateTime
  startSlot   Float
  endSlot     Float
  hours       Float
  process     String
  isOverride  Boolean  @default(false)
  isAfternoon Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())

  planning          Planning          @relation(fields: [planningId], references: [id], onDelete: Cascade)
  task              Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  person            Person            @relation(fields: [personId], references: [id])
  processDefinition ProcessDefinition @relation(fields: [process], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@index([planningId, personId, date])
}

model Absence {
  id                String   @id @default(cuid())
  personId          String
  /// Inicio del periodo (medianoche UTC del día civil).
  date              DateTime
  /// Fin inclusive del periodo; igual a date en ausencias de un solo día.
  endDate           DateTime
  hours             Float    @default(8)
  /// Con blockEndMinutes, [start, end) dentro del día laboral. 0–1440 = día completo.
  blockStartMinutes Int?
  blockEndMinutes   Int?
  reason            String?

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, date, endDate])
}

/// Rango inclusive [startDate, endDate] en días UTC (medianoche).
model Holiday {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  name      String

  @@index([startDate, endDate])
}

// ---------- Registro de horas ----------

model TimeEntry {
  id        String          @id @default(cuid())
  userId    String
  projectId String?
  lampId    String?
  taskId    String?
  process   String?
  source    TimeEntrySource @default(MANUAL)
  startedAt DateTime
  endedAt   DateTime?
  hours     Float?
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user              User               @relation(fields: [userId], references: [id])
  project           Project?           @relation(fields: [projectId], references: [id])
  lamp              Lamp?              @relation(fields: [lampId], references: [id])
  task              Task?              @relation(fields: [taskId], references: [id])
  processDefinition ProcessDefinition? @relation(fields: [process], references: [code], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, startedAt])
}

model AttendanceSession {
  id        String           @id @default(cuid())
  userId    String
  personId  String
  source    AttendanceSource @default(BUTTON)
  startedAt DateTime
  endedAt   DateTime?
  minutes   Int?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  breaks AttendanceBreak[]

  @@index([userId, startedAt])
  @@index([personId, startedAt])
}

model AttendanceBreak {
  id        String           @id @default(cuid())
  sessionId String
  source    AttendanceSource @default(BUTTON)
  startedAt DateTime
  endedAt   DateTime?
  minutes   Int?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, startedAt])
}

// ---------- Política de desviación de tiempos (catálogo) ----------

model TimeDeviationPolicy {
  id                    String   @id @default("singleton")
  deviationThresholdPct Float    @default(15)
  movingAverageSamples  Int      @default(10)
  updatedAt             DateTime @updatedAt
}

// ---------- Notificaciones ----------

model Notification {
  id         String            @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  payload    Json?
  readAt     DateTime?
  naveId     String?
  projectId  String?
  planningId String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nave     Nave?    @relation(fields: [naveId], references: [id], onDelete: SetNull)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  planning Planning? @relation(fields: [planningId], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model NotificationSubscription {
  id      String            @id @default(cuid())
  userId  String
  type    NotificationType
  inApp   Boolean           @default(true)
  email   Boolean           @default(true)
  push    Boolean           @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([type])
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  notificationId String?
  userId         String
  type           NotificationType
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  payload        Json?
  dedupeKey      String                     @unique
  attempts       Int                        @default(0)
  maxAttempts    Int                        @default(5)
  nextAttemptAt  DateTime                   @default(now())
  lockedAt       DateTime?
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([channel, status])
}

model PushSubscription {
  id             String    @id @default(cuid())
  userId         String
  endpoint       String    @unique
  p256dh         String
  auth           String
  expirationTime DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model NotificationState {
  id             String           @id @default(cuid())
  userId         String
  type           NotificationType
  scopeKey       String
  isActive       Boolean          @default(true)
  firstNotifiedAt DateTime        @default(now())
  lastNotifiedAt DateTime         @default(now())
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, scopeKey])
  @@index([type, scopeKey])
}

// ---------- Órdenes de producción ----------

model ProductionOrder {
  id          String    @id @default(cuid())
  number      String    @unique
  year        Int
  serial      Int
  projectId   String
  lampLabel   String?
  process     String?
  hours       Float?
  scheduledAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  project           Project            @relation(fields: [projectId], references: [id])
  processDefinition ProcessDefinition? @relation(fields: [process], references: [code], onDelete: SetNull, onUpdate: Cascade)

  @@unique([year, serial])
}

// ---------- Fábrica ----------

model FactoryItem {
  id          String        @id @default(cuid())
  code        String?
  product     String
  client      String?
  obra        String?
  nave        String?
  status      FactoryStatus @default(DOSSIER)
  scheduledAt DateTime?
  shippedAt   DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

// ---------- Trazabilidad / auditoría ----------

model AuditLog {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())

  actorUserId String?
  actorRole   Role?
  actorName   String?
  actorEmail  String?

  action      String
  category    String
  outcome     AuditOutcome

  naveId      String?
  ipAddress   String?
  userAgent   String?

  entityType  String?
  entityId    String?

  summary     String
  metadata    Json?
  changes     Json?

  @@index([createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([outcome, createdAt(sort: Desc)])
  @@index([entityType, entityId])
}
